OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=minimal
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=
CLINIC_AGENT_MODE=single
CLINIC_PROVIDER_ROUTING=openai
# Optional external place lookup. Never add a real key to this shared file.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
# Optional official remote MCP search. A private key opts in unless disabled.
TAVILY_API_KEY=
TAVILY_ENABLED=true
# Optional local experiment only; leave the key unset in shared files.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ENABLE_THINKING=false
APP_RELOAD=true
PUBLIC_CHAT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=3
CHAT_RATE_LIMIT_PER_DAY=10

MCP_SERVERS_CONFIG=mcp_config.json
CLINIC_DB_PATH=data/clinic_operations.db
CLINIC_REFRESH_DEMO_DATA=true
CLINIC_TIMEZONE=America/Los_Angeles
CLINIC_APPOINTMENTS_DB_PATH=data/clinic_appointments.db
CLINIC_KNOWLEDGE_DIR=clinic_knowledge
CLINIC_KNOWLEDGE_INDEX_DIR=data
CLINIC_KNOWLEDGE_SEARCH_MODE=semantic
